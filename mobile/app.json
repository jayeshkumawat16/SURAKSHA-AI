
{
  "expo": {
    "name": "SURAKSHA AI",
    "slug": "suraksha-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "suraksha",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suraksha.ai",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SURAKSHA AI requires your location only when you explicitly tap to add coordinates to an emergency SOS dispatch or find nearby lifeline shelters."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1128"
      },
      "package": "com.suraksha.ai",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A1128"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
