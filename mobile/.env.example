# ==============================================================================
# SURAKSHA AI MOBILE CLIENT CONFIGURATION
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# This file is PUBLIC configuration bundled with the mobile client.
# NEVER put GEMINI_API_KEY or private credentials in this file or any Expo variable.
# All Gemini AI credentials MUST remain strictly server-side in backend/.env.
# ==============================================================================

# Backend API Base URL Options:
#
# 1. iOS Simulator (running on this Mac):
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#
# 2. Android Emulator (Android Studio loopback alias for host Mac):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
#
# 3. Physical Android / iPhone (on the same Wi-Fi network as this Mac):
# Replace 192.168.1.XX with your Mac's local network IP (run: ipconfig getifaddr en0)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.15:8000

EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
